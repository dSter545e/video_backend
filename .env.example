PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ott_platform
JWT_SECRET=change-this-secret
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@ott.com
ADMIN_PASSWORD=admin123
# Comma-separated frontend origins (user site, admin, extra domains on same backend)
# Used for Express API CORS and R2 bucket CORS (run: npm run configure:r2-cors)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Optional: set true only for quick local testing (allows any origin on the API)
# CORS_ALLOW_ALL=true
# R2 / Cloudflare storage is configured in Admin → Storage (database), not here.
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# Health monitor cron (R2 servers + video online status)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_HOURS=24
