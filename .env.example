PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/ott_platform
JWT_SECRET=change-this-secret
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@ott.com
ADMIN_PASSWORD=admin123
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=your-r2-bucket-name
# Use a public custom domain or leave empty to use https://<bucket>.r2.dev
# Do NOT use *.r2.cloudflarestorage.com here (private API endpoint)
R2_PUBLIC_BASE_URL=https://cdn.your-domain.com
# Comma-separated frontend origins (user site, admin, extra domains on same backend)
# Used for Express API CORS and R2 bucket CORS (run: npm run configure:r2-cors)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Optional: set true only for quick local testing (allows any origin on the API)
# CORS_ALLOW_ALL=true
# Legacy alias — CORS_ORIGINS is preferred
# R2_CORS_ORIGINS=
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=24
