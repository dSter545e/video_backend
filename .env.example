PORT=5000
# Large video uploads (admin process-upload)
UPLOAD_MAX_FILE_MB=1024
# 0 = no limit (recommended for 50MB–1GB uploads). Node default is ~5 minutes.
UPLOAD_REQUEST_TIMEOUT_MS=0
UPLOAD_HEADERS_TIMEOUT_MS=120000
MONGO_URI=mongodb://127.0.0.1:27017/ott_platform
JWT_SECRET=change-this-secret
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@ott.com
ADMIN_PASSWORD=admin123
# Comma-separated frontend origins (scheme + host, no trailing slash)
# MUST include your production admin + user URLs, e.g.:
# CORS_ORIGINS=https://xhub4u.com,https://www.xhub4u.com,https://admin.xhub4u.com
# Or allow all subdomains of one domain:
# CORS_ORIGIN_SUFFIX=.xhub4u.com
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# CORS_ORIGIN_SUFFIX=.yourdomain.com
# Public API base URL used in video/media proxy links returned by the API (required in production)
# Example: https://api.yourdomain.com
# API_PUBLIC_URL=
# --- Production upload checklist (nginx / reverse proxy in front of Node) ---
# client_max_body_size 1024m;
# proxy_read_timeout 3600s;
# proxy_send_timeout 3600s;
# proxy_request_buffering off;
# If Cloudflare proxies the API: free plan limits uploads to ~100MB — use DNS-only (grey cloud) for api.*
# Admin app: NEXT_PUBLIC_API_URL=https://api.yourdomain.com (HTTPS, same as browser can reach)
# Test from browser: GET https://api.yourdomain.com/api/health/upload (check corsAllowed: true)
# Optional: set true only for quick local testing (allows any origin on the API)
# CORS_ALLOW_ALL=true
# R2 / Cloudflare storage is configured in Admin → Storage (database), not here.
# R2 upload tuning (video processing uploads many HLS segments after transcode)
# R2_BUFFER_UPLOAD_MAX_MB=100
# R2_UPLOAD_TIMEOUT_MS=120000
# R2_UPLOAD_MAX_ATTEMPTS=3
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# Health monitor cron (R2 servers + video online status)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_HOURS=24
# Watermark settings are stored in the database (Admin → Watermark).
