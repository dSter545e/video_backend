PORT=5000
# Large video uploads (admin process-upload)
UPLOAD_MAX_FILE_MB=1024
# 0 = no limit (recommended for 50MB–1GB uploads). Node default is ~5 minutes.
UPLOAD_REQUEST_TIMEOUT_MS=0
UPLOAD_HEADERS_TIMEOUT_MS=120000
MONGO_URI=mongodb://127.0.0.1:27017/ott_platform
JWT_SECRET=change-this-secret
ADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@ott.com
ADMIN_PASSWORD=admin123
# Comma-separated frontend origins (user site, admin, extra domains on same backend)
# Used for Express API CORS and R2 bucket CORS (run: npm run configure:r2-cors)
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001
# Public API base URL used in video/media proxy links returned by the API (required in production)
# Example: https://api.yourdomain.com
# API_PUBLIC_URL=
# Optional: set true only for quick local testing (allows any origin on the API)
# CORS_ALLOW_ALL=true
# R2 / Cloudflare storage is configured in Admin → Storage (database), not here.
# R2 upload tuning (video processing uploads many HLS segments after transcode)
# R2_BUFFER_UPLOAD_MAX_MB=100
# R2_UPLOAD_TIMEOUT_MS=120000
# R2_UPLOAD_MAX_ATTEMPTS=3
BACKUP_AUTO_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# Health monitor cron (R2 servers + video online status)
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL_HOURS=24
# Watermark settings are stored in the database (Admin → Watermark).
# Regenerate thumbnails + preview clips (deletes old R2 files first, then creates new):
#   npm run regenerate:media              — all videos with HLS
#   npm run regenerate:media -- --id=<mongoId>
#   npm run regenerate:media -- --dry-run --limit=10
#   npm run regenerate:media -- --preview-only
#   npm run regenerate:media -- --thumbnail-only
#   npm run regenerate:media -- --include-custom-thumbnails
# Backfill preview clips for existing videos (legacy):
#   npm run backfill:previews          — videos missing a preview only
#   npm run backfill:previews:all      — regenerate previews for all videos
# Optional flags: --dry-run --limit=50 --id=<mongoId>
